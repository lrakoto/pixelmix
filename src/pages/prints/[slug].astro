---
import Layout from '../../layouts/Layout.astro';
import { prints, getPrint } from '../../data/prints';

// Astro's getStaticPaths runs at build time. It tells Astro which
// /prints/<slug>/ pages to generate. Without this, no detail pages
// get created even though the route file exists.
export async function getStaticPaths() {
  return prints.map((p) => ({ params: { slug: p.slug } }));
}

const slug = Astro.params.slug ?? '';
const p = getPrint(slug);
if (!p) {
  // Should be unreachable because getStaticPaths only emits valid slugs,
  // but we make TypeScript happy.
  return Astro.redirect('/gallery');
}
---

<Layout
  title={`${p.title} — Pixelmix`}
  description={p.description}
>
  <section class="container">
    <div class="detail">
      <div class="detail-gallery" data-images={JSON.stringify(p.images)}>
        <button
          class="detail-art"
          type="button"
          data-lightbox-trigger
          aria-label={`View ${p.title} at full size`}
        >
          <img
            id="main-image"
            src={p.images[0]}
            alt={`${p.title} by ${p.artist}`}
            loading="eager"
            decoding="async"
          />
        </button>

        {p.images.length > 1 && (
          <div class="carousel" role="region" aria-label={`${p.title} mockups`}>
            {p.images.map((img, i) => (
              <button
                class={`carousel-thumb ${i === 0 ? 'is-active' : ''}`}
                type="button"
                data-index={i}
                aria-label={`View image ${i + 1} of ${p.images.length}`}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                <img
                  src={img}
                  alt={`${p.title} view ${i + 1}`}
                  loading={i < 4 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="detail-body">
        <span class="eyebrow">{p.edition}</span>
        <h1>{p.title}</h1>
        <p class="detail-artist">by {p.artist}</p>
        <p class="detail-price">${p.price}</p>
        <p class="detail-desc">{p.description}</p>

        <dl class="specs">
          <dt>Size</dt><dd>{p.size}</dd>
          <dt>Paper</dt><dd>{p.paper}</dd>
          <dt>Edition</dt><dd>{p.edition}</dd>
        </dl>

        <div class="btn-row">
          {p.buyUrl ? (
            <a class="btn btn-primary" href={p.buyUrl} target="_blank" rel="noopener">
              Buy — ${p.price} →
            </a>
          ) : (
            <a class="btn btn-primary" href="/contact">Order this print →</a>
          )}
          <a class="btn" href="/gallery">← Back to gallery</a>
        </div>
      </div>
    </div>
  </section>

  <!--
    Lightbox modal. Closed by default; the script below toggles
    `is-open` on the .lightbox element and `lightbox-open` on <body>.

    Renders the same image at its natural resolution. If a future
    schema adds `images: string[]` to Print, this scaffold stays
    the same — only the <img> inside .lightbox-stage becomes a
    swipable list, and the JS grows prev/next handlers.
  -->
  <div
    class="lightbox"
    id="lightbox"
    role="dialog"
    aria-modal="true"
    aria-labelledby="lightbox-caption"
    hidden
  >
    <button
      class="lightbox-close"
      type="button"
      data-lightbox-close
      aria-label="Close image viewer"
    >×</button>
    <div class="lightbox-stage">
      <img
        id="lightbox-image"
        src={p.images[0]}
        alt={`${p.title} by ${p.artist}`}
      />
    </div>
    <p class="lightbox-caption" id="lightbox-caption">{p.title} — by {p.artist}</p>
  </div>
</Layout>

<script>
  // Click-to-zoom lightbox.
  // - Click the .detail-art button (or focus + Enter/Space) to open.
  // - Click backdrop, click ×, or press Escape to close.
  // - When open, body scroll is locked and focus moves to the close
  //   button; on close, focus returns to the trigger.
  // - No external deps. ~50 lines.

  (() => {
    const gallery = document.querySelector('.detail-gallery');
    const images: string[] = JSON.parse(gallery?.getAttribute('data-images') || '[]');
    const trigger = document.querySelector<HTMLButtonElement>('[data-lightbox-trigger]');
    const lightbox = document.getElementById('lightbox');
    const closeBtn = lightbox?.querySelector<HTMLButtonElement>('[data-lightbox-close]');
    const lightboxImg = document.getElementById('lightbox-image') as HTMLImageElement | null;
    const mainImage = document.getElementById('main-image') as HTMLImageElement | null;
    const carousel = document.querySelector('.carousel');
    if (!trigger || !lightbox || !closeBtn || !lightboxImg || !mainImage || images.length === 0) return;

    let lastFocused: HTMLElement | null = null;
    let currentIndex = 0;

    function setImage(index: number) {
      currentIndex = index;
      const src = images[index];
      mainImage.src = src;
      lightboxImg.src = src;
      document.querySelectorAll('.carousel-thumb').forEach((btn, i) => {
        btn.classList.toggle('is-active', i === index);
        btn.setAttribute('aria-pressed', i === index ? 'true' : 'false');
      });
    }

    if (carousel) {
      carousel.addEventListener('click', (e) => {
        const thumb = (e.target as HTMLElement).closest<HTMLButtonElement>('.carousel-thumb');
        if (!thumb) return;
        const index = Number(thumb.dataset.index ?? 0);
        setImage(index);
      });
    }

    function open() {
      lastFocused = document.activeElement as HTMLElement | null;
      lightbox!.removeAttribute('hidden');
      // Force a reflow so the .is-open class can animate the fade-in
      // from display:none via the keyframes; otherwise the first frame
      // is hidden then snaps visible without animation.
      void lightbox!.offsetWidth;
      lightbox!.classList.add('is-open');
      document.body.classList.add('lightbox-open');
      closeBtn!.focus();
    }

    function close() {
      lightbox!.classList.remove('is-open');
      document.body.classList.remove('lightbox-open');
      // After the fade-out, hide from the a11y tree too.
      window.setTimeout(() => lightbox!.setAttribute('hidden', ''), 200);
      lastFocused?.focus();
    }

    trigger.addEventListener('click', open);
    closeBtn.addEventListener('click', close);

    // Click outside the image (on the dim backdrop) closes.
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });

    // Keyboard: Escape closes; basic focus trap inside the dialog.
    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('is-open')) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
        return;
      }
      if (e.key === 'Tab') {
        // The only focusable element in the dialog is the close button,
        // so a simple trap is to keep focus on it.
        e.preventDefault();
        closeBtn.focus();
      }
    });
  })();
</script>
